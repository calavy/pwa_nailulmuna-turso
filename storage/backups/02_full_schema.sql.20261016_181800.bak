);

CREATE TABLE IF NOT EXISTS cashless_nominal_qr_map (
    id INTEGER PRIMARY KEY,
    kode_qr VARCHAR(120) NOT NULL,
    nominal INTEGER NOT NULL DEFAULT 0,
    keterangan VARCHAR(160) NULL,
