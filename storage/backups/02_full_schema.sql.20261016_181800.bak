    created_at TEXT DEFAULT (datetime('now'))
);

CREATE TABLE IF NOT EXISTS akademik_hafalan_setoran (
    id INTEGER PRIMARY KEY,
    santri_id INTEGER NOT NULL,
    tanggal_setoran TEXT NOT NULL,
