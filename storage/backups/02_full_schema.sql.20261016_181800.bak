    catatan VARCHAR(255) NULL,
    created_at TEXT DEFAULT (datetime('now')), jenis_domisili, tahun_ajaran_mulai),
    CONSTRAINT fk_srd_santri FOREIGN KEY (santri_id) REFERENCES santri(id) ON DELETE CASCADE
);

