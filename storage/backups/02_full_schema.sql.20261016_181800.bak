);

CREATE TABLE IF NOT EXISTS keuangan_pembayaran (
    id INTEGER PRIMARY KEY,
    santri_id INTEGER NOT NULL,
    jenis_periode TEXT NOT NULL DEFAULT 'BULANAN',
    tahun_ajaran_mulai INTEGER NOT NULL,
