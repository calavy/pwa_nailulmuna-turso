<?php

declare(strict_types=1);

/**
 * Bangun migrations/turso/02_full_schema.sql dari DDL MySQL (tanpa INSERT/data).
 * Prefer live MySQL: php scripts/build_turso_schema_from_mysql.php
 * CLI fallback dump: php scripts/build_turso_schema.php
 */
$root = dirname(__DIR__);
require_once $root . '/helpers/turso_schema_convert.php';

if (in_array('--from-mysql', $argv ?? [], true)) {
    passthru(PHP_BINARY . ' ' . escapeshellarg($root . '/scripts/build_turso_schema_from_mysql.php'), $code);
    exit($code);
}

$sources = [
    $root . '/impor_lokal_pwa_nailulmuna.sql',
    $root . '/migrasi_terbaru.sql',
];
$out = $root . '/migrations/turso/02_full_schema.sql';

$chunks = [];
$chunks[] = "-- Generated by scripts/build_turso_schema.php — review before apply to Turso prod\n";
$chunks[] = "PRAGMA foreign_keys = OFF;\n";
$seenCreate = [];

foreach ($sources as $file) {
    if (!is_file($file)) {
        fwrite(STDERR, "Skip missing: {$file}\n");
        continue;
    }
    $sql = file_get_contents($file);
    if (!is_string($sql)) {
        continue;
    }
    $sql = preg_replace('/^--.*$/m', '', $sql) ?? $sql;
    $sql = preg_replace('/\/\*.*?\*\//s', '', $sql) ?? $sql;
    $statements = turso_split_sql_statements_loose($sql);
    foreach ($statements as $stmt) {
        $trim = trim($stmt);
        if ($trim === '') {
            continue;
        }
        $upper = strtoupper($trim);
        if (str_starts_with($upper, 'INSERT ')
            || str_starts_with($upper, 'UPDATE ')
            || str_starts_with($upper, 'DELETE ')
            || str_starts_with($upper, 'USE ')
            || str_starts_with($upper, 'CREATE DATABASE')
            || str_starts_with($upper, 'SET NAMES')
            || str_starts_with($upper, 'SET FOREIGN_KEY')
        ) {
            continue;
        }
        if (str_starts_with($upper, 'CREATE TABLE')) {
            $converted = turso_convert_mysql_create_table($trim);
            if (!preg_match('/CREATE TABLE IF NOT EXISTS\s+(\w+)/i', $converted['create'], $tm)) {
                $chunks[] = $converted['create'] . "\n";
                continue;
            }
            $tname = strtolower($tm[1]);
            if (isset($seenCreate[$tname])) {
                continue;
            }
            $seenCreate[$tname] = true;
            $chunks[] = $converted['create'] . "\n";
            foreach ($converted['indexes'] as $idx) {
                $chunks[] = $idx . "\n";
            }
            continue;
        }
        if (str_starts_with($upper, 'ALTER TABLE')) {
            foreach (turso_convert_mysql_alter($trim) as $line) {
                $chunks[] = $line . "\n";
            }
        }
    }
}

$chunks[] = "PRAGMA foreign_keys = ON;\n";
$sql = implode("\n", $chunks);
file_put_contents($out, $sql);
echo "Wrote {$out}\n";

/** @return list<string> */
function turso_split_sql_statements_loose(string $sql): array
{
    $parts = [];
    $depth = 0;
    $buf = '';
    $len = strlen($sql);
    for ($i = 0; $i < $len; $i++) {
        $c = $sql[$i];
        if ($c === '(') {
            $depth++;
        } elseif ($c === ')') {
            $depth--;
        }
        if ($c === ';' && $depth === 0) {
            $parts[] = trim($buf);
            $buf = '';
            continue;
        }
        $buf .= $c;
    }
    if (trim($buf) !== '') {
        $parts[] = trim($buf);
    }

    return $parts;
}
